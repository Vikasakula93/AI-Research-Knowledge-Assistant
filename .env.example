# FastAPI Configuration
ENVIRONMENT=development
DEBUG=True
API_TITLE=AI Research & Knowledge Assistant
API_VERSION=1.0.0
API_DESCRIPTION=An intelligent assistant for research papers and technical documents

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./research_assistant.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# LLM Configuration
sk-your-actual-key-here-replace-this
OPENAI_API_KEY=sk-your-actual-key-here-replace-this
LLM_MAX_TOKENS=1000

# Embedding Configuration
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Database Configuration
VECTOR_DB_TYPE=faiss  # Options: faiss, pinecone, weaviate
# For Pinecone
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=research-assistant

# Document Processing
MAX_UPLOAD_SIZE=50000000  # 50MB in bytes
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SUPPORTED_FILE_TYPES=pdf,txt,docx

# TensorFlow Model
TF_MODEL_PATH=./ml_models/document_classifier.h5
CLASSIFICATION_CATEGORIES=AI,ML,CV,NLP,Robotics,CyberSecurity,CloudComputing

# Redis Configuration (for caching & session management)
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# File Storage
UPLOAD_DIRECTORY=./uploads
CHUNK_STORAGE_DIRECTORY=./data/chunks